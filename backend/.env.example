# Django Settings
SECRET_KEY=your-secret-key-here
# DEBUG=False en production : SECRET_KEY devient alors obligatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=syntax_gu_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.1.10:5173,http://192.168.1.10:8081

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Email Settings (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-password

# Fichiers (laisser vide en développement : backend/media et backend/staticfiles)
# MEDIA_ROOT=/srv/manzanza/media
# STATIC_ROOT=/srv/manzanza/static
# Validité des liens signés vers les fichiers privés (secondes)
MEDIA_SIGNED_URL_MAX_AGE=7200

# Mobile Money : secret HMAC partagé avec l'agrégateur (vide = rappels désactivés)
MOBILE_MONEY_WEBHOOK_SECRET=

# Corbeille : durée de conservation par défaut (jours) — modifiable ensuite par l'iAdmin
TRASH_RETENTION_DAYS=60

# URL publique du frontend (liens de vérification des reçus)
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@manzanza.ac.cd

# Limites anti-abus (requêtes)
THROTTLE_LOGIN=10/minute
THROTTLE_PUBLIC_FORM=5/hour
